{
  "name": "u4-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "extract": "tsx tools/extract-assets.ts",
    "assets:local": "git checkout local/bundled-assets -- assets/i18n assets/packs && git reset -q assets/i18n assets/packs",
    "tauri": "tauri",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
