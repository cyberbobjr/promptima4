// Deployment of promptima.app on Cloudflare (a Worker serving the built site as static assets).
// `npm run deploy` builds dist/ and uploads it; the custom domain route creates the DNS record and the certificate.
{
  "name": "promptima",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "promptima.app", "custom_domain": true }
  ]
}
